{
  "name": "improve-shows",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci --cache .sites-runtime/npm-cache --no-audit --no-fund",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "vinext build && npm run validate:artifact",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --conditions=react-server --import tsx --test tests/rendered-html.test.mjs tests/better-auth-compatibility.test.ts tests/better-auth-schema.test.ts tests/better-auth-hardened-schema.test.ts tests/better-auth-hardened-migration.test.ts tests/database-env.test.ts tests/test-database-env.test.ts tests/database-adapter.test.ts tests/database-schema.test.ts tests/organization-onboarding.test.ts tests/postgres-organization-onboarding-store.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/integration/organization-onboarding-postgres.test.ts",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node --conditions=react-server --import tsx scripts/check-database.ts",
    "db:test:prepare": "node --import tsx scripts/prepare-test-database.ts",
    "db:test:check": "node --import tsx scripts/check-test-database.ts"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "IMPROVE — Marketplace de Shows"
}
